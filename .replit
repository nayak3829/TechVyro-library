modules = ["nodejs-20", "python-3.12", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "libdrm", "expat", "xorg.libxcb", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "mesa", "pango", "cairo", "alsa-lib", "libgbm", "libxkbcommon", "at-spi2-core"]

[userenv]

[userenv.shared]

[userenv.production]
NEXT_PUBLIC_SITE_URL = "https://techvyro-library.replit.app"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80


[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "HOSTNAME=0.0.0.0 PORT=5000 node .deploy/server.js"]
build = ["sh", "-c", "pnpm run build && rm -rf .deploy && cp -R .next/standalone .deploy && mkdir -p .deploy/.next && cp -R .next/static .deploy/.next/static && rm -rf .deploy/public && cp -R public .deploy/public && size_kb=$(du -sk .deploy | cut -f1) && { [ \"$size_kb\" -lt 7340032 ] || { echo \"Deployment bundle exceeds 7 GiB safety limit\" >&2; exit 1; }; } && rm -rf node_modules .next"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
